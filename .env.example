# Only set in production. When unset, the app uses a local PGlite database in .data/
DATABASE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
OWNER_EMAIL=
CRON_SECRET=
# Time zone that decides what "today" means for due dates (default America/Toronto)
APP_TIME_ZONE=
# Production only: AUTH_TRUST_HOST=true
# Email sign-in links (optional): turns on "Email me a link" on the sign-in page
AUTH_RESEND_KEY=
EMAIL_FROM=login@minhlongvu.com
